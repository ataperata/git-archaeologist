# GitHub token used to map commits to pull requests, reviews, and issues.
# Fine-grained: Contents (read) and Pull requests (read) on the target repo.
# Never commit a real token. Leave this empty to stay on fixture or synthesized data.
GITHUB_TOKEN=

# Override for GitHub Enterprise Server. No trailing slash.
GITHUB_API_URL=https://api.github.com

# OpenAI-compatible chat completions API. The client posts to ${LLM_BASE_URL}/chat/completions.
# Examples: https://api.openai.com/v1   https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 1 forces the heuristic narrator and skips GitHub and LLM network calls.
GIT_ARCHAEOLOGIST_OFFLINE=0

# Disk cache for GitHub and LLM responses. Defaults to $XDG_CACHE_HOME/git-archaeologist
# or ~/.cache/git-archaeologist.
# GIT_ARCHAEOLOGIST_CACHE_DIR=

# Fixture id (acme/widget) or a path to a fixture JSON file.
# When unset, the bundled fixture is used only if the repo origin is github.com/acme/widget.
# GIT_ARCHAEOLOGIST_FIXTURE=
